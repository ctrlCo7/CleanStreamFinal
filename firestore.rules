rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    // An account the Super Admin has deactivated or removed loses every power immediately
    // (not just the ability to sign in again).
    function inGoodStanding() {
      return getUserData().get('isActive', true) != false && !('deletedAt' in getUserData());
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role && inGoodStanding();
    }

    // Admin and Barangay Official sign-ups must have their ID and face checked by the
    // Super Admin. Until then the profile is marked idVerification == 'pending' (or
    // 'rejected') and carries NO staff powers. Accounts without the field (everyone who
    // existed before this check, and accounts the Super Admin created) are unaffected.
    function idCleared() {
      return getUserData().get('idVerification', 'approved') == 'approved';
    }

    function isAdmin() {
      return hasRole('admin') && idCleared();
    }

    // The Super Admin (web portal only) is the sole manager of accounts: creating,
    // editing, deactivating and removing them. Admins keep read access to users
    // (for messaging/analytics) but can no longer change anyone's account.
    // A deactivated or removed Super Admin immediately loses these powers.
    function isSuperAdmin() {
      return hasRole('superadmin')
          && getUserData().get('isActive', true) != false
          && !('deletedAt' in getUserData());
    }

    function isBarangayOfficer() {
      return hasRole('barangay') && idCleared();
    }

    function isCleanupTeam() {
      return hasRole('cleanup_team');
    }

    function isCitizen() {
      return hasRole('citizen');
    }

    function isAdminOrBarangay() {
      return isAuthenticated() && getUserData().role in ['admin', 'barangay'] && idCleared() && inGoodStanding();
    }

    function isStaff() {
      return isAuthenticated() && getUserData().role in ['admin', 'barangay', 'cleanup_team'] && idCleared() && inGoodStanding();
    }

    function isOwner(userId) {
      return isAuthenticated() && currentUid() == userId;
    }

    function sameBarangay(barangayId) {
      return isAuthenticated() && getUserData().barangayId == barangayId;
    }

    function isNotDeleted() {
      return !('deleted' in resource.data) || resource.data.deleted == false;
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    // citizens read own profile; admin reads all; barangay reads members;
    // only the Super Admin can create arbitrary accounts or change/remove anyone's.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin() || isAdmin() || isBarangayOfficer();
      // Self sign-up can never grant itself approval or powers: it must start unverified and
      // active, and a Barangay Official or Admin must start with idVerification == 'pending'.
      allow create: if (isAuthenticated() && currentUid() == userId
                        && request.resource.data.keys().hasAll(['uid', 'email', 'firstName', 'lastName', 'role'])
                        && request.resource.data.get('isVerified', false) == false
                        && request.resource.data.get('isActive', true) == true
                        && !('deletedAt' in request.resource.data)
                        // Cleanup-team accounts are created only by the Super Admin (web portal).
                        && (request.resource.data.role == 'citizen'
                            || (request.resource.data.role in ['barangay', 'admin']
                                && request.resource.data.get('idVerification', '') == 'pending')))
                    || isSuperAdmin();
      // Owners can't touch privileged fields, except resubmitting after a rejection
      // (idVerification 'rejected' -> 'pending').
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'isVerified', 'isActive', 'deletedAt', 'deletedBy', 'createdBy', 'idRejectionReason'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['idVerification'])
                            || (resource.data.get('idVerification', '') == 'rejected'
                                && request.resource.data.idVerification == 'pending')))
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Identity verification (ID photo + selfies) ───────────────────────────
    // Very sensitive: readable only by the applicant and the Super Admin. The Super Admin
    // portal deletes the images as soon as a decision is made.
    match /verifications/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending'
                    && getUserData().get('idVerification', '') == 'pending'
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'idType', 'idImage', 'selfieNeutral',
                         'selfieSmile', 'selfieTurn', 'clientChecks', 'status', 'submittedAt']);
      // Only a rejected applicant can send a new submission; everything else is the reviewer's.
      allow update: if isSuperAdmin()
                    || (isOwner(uid)
                        && resource.data.status == 'rejected'
                        && request.resource.data.uid == uid
                        && request.resource.data.status == 'pending'
                        && getUserData().get('idVerification', '') == 'pending'
                        && request.resource.data.keys().hasOnly(['uid', 'role', 'idType', 'idImage', 'selfieNeutral',
                             'selfieSmile', 'selfieTurn', 'clientChecks', 'status', 'submittedAt']));
      allow delete: if isSuperAdmin();
    }

    // ─── Audit log (Super Admin portal) ─────────────────────────────────────────
    // Append-only record of every account change made from the web portal.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.actorUid == currentUid();
      allow update, delete: if false;
    }

    // ─── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Public within the app: the live waste Map screen queries the whole
      // collection with no owner filter, so any authenticated user (any role)
      // must be able to read any report for the map + report-detail views.
      allow read: if isAuthenticated();

      // Citizens and barangay officers can create reports
      allow create: if isAuthenticated()
                    && (isCitizen() || isBarangayOfficer())
                    && request.resource.data.userId == currentUid()
                    && request.resource.data.keys().hasAll(['userId', 'location', 'status', 'severity']);

      // Status transitions — strict role-based write access
      allow update: if isAuthenticated() && (
                      // Owner can only update notes/photos on pending reports
                      (isOwner(resource.data.userId)
                        && resource.data.status == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['status', 'severity', 'userId', 'aiAnalysis'])) ||

                      // Barangay: verify, reject, assign and close out reports in own barangay
                      (isBarangayOfficer()
                        && sameBarangay(resource.data.barangayId)
                        && request.resource.data.status in ['verified', 'assigned', 'in_progress', 'completed', 'rejected']) ||

                      // Admin: unrestricted update
                      isAdmin() ||

                      // AI service (server-side): update aiAnalysis field
                      (isOwner(resource.data.userId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['aiAnalysis', 'severity', 'wasteTypes', 'updatedAt']))
                    );

      allow delete: if isAdmin();
    }

    // ─── Barangays ─────────────────────────────────────────────────────────────
    match /barangays/{barangayId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isBarangayOfficer() && sameBarangay(barangayId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['isActive', 'captainName']));
      allow delete: if isAdmin();
    }

    // ─── Field Checkpoints (barangay officer patrol/inspection reports) ─────────
    match /fieldCheckpoints/{checkpointId} {
      // Owner reads their own submissions; admin reviews/verifies across all barangays
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isBarangayOfficer() && request.resource.data.userId == currentUid();
      // Only admin can verify, and only the verification fields may change
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'verifiedBy', 'verifiedByName', 'verifiedAt']);
      allow delete: if isAdmin();
    }

    // ─── Checkpoint Alarms (admin sets each barangay's daily check time; ───────
    // ─── barangay officers can only read their own barangay's config) ─────────
    match /checkpointAlarms/{barangayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Cleanup Tasks ──────────────────────────────────────────────────────────
    match /cleanupTasks/{taskId} {
      // Admin sees all; an official only their own barangay's; a crew leader only their own tasks.
      allow read: if isAuthenticated() && (
                    isAdmin() ||
                    (isBarangayOfficer() && sameBarangay(resource.data.barangayId)) ||
                    (isCleanupTeam() && resource.data.assignedTeamId == currentUid())
                  );

      // Created by the Admin, or by an official for their own barangay, always as themselves.
      allow create: if isAuthenticated()
                    && request.resource.data.assignedByUserId == currentUid()
                    && (isAdmin()
                        || (isBarangayOfficer() && request.resource.data.barangayId == getUserData().barangayId));

      allow update: if isAuthenticated() && (
                      isAdmin() ||
                      // An official can manage (and record work on behalf of a crew for) their barangay's tasks
                      (isBarangayOfficer() && sameBarangay(resource.data.barangayId)) ||
                      // A crew leader can accept/decline, start, document and finish only their own task,
                      // and cannot hand it to someone else
                      (isCleanupTeam()
                        && resource.data.assignedTeamId == currentUid()
                        && request.resource.data.assignedTeamId == resource.data.assignedTeamId
                        && request.resource.data.status in ['accepted', 'in_progress', 'completed', 'cancelled']
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'declineReason', 'progressNotes', 'completionNotes',
                                      'actualStartTime', 'actualEndTime', 'completedAt',
                                      'wasteCollectedKg', 'beforePhotoURLs', 'afterPhotoURLs', 'updatedAt']))
                    );

      allow delete: if isAdmin();
    }

    // ─── Cleanup Events ────────────────────────────────────────────────────────
    match /cleanupEvents/{eventId} {
      allow read: if isAuthenticated();
      // Created by the Admin, or by an official for their own barangay, always as themselves.
      allow create: if isAuthenticated()
                    && request.resource.data.organizedBy == currentUid()
                    && (isAdmin()
                        || (isBarangayOfficer() && request.resource.data.barangayId == getUserData().barangayId));
      allow update: if isAdmin()
                    || (isBarangayOfficer() && sameBarangay(resource.data.barangayId))
                    // Anyone signed in can add or remove only THEMSELVES from the volunteer list, and the
                    // count must equal the list, so it can't be inflated.
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['participantIds', 'currentParticipants', 'updatedAt'])
                        && request.resource.data.currentParticipants == request.resource.data.participantIds.size()
                        && (
                          (request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet()).hasOnly([currentUid()])
                            && resource.data.participantIds.toSet().difference(request.resource.data.participantIds.toSet()).size() == 0)
                          ||
                          (resource.data.participantIds.toSet().difference(request.resource.data.participantIds.toSet()).hasOnly([currentUid()])
                            && request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet()).size() == 0)
                        ));
      allow delete: if isAdmin();

      // Participants subcollection: residents join/leave themselves; only officials mark attendance
      match /participants/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.attendanceStatus == 'registered';
        allow update: if (isOwner(userId)
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['attendanceStatus']))
                      || isAdmin()
                      || (isBarangayOfficer()
                          && get(/databases/$(database)/documents/cleanupEvents/$(eventId)).data.barangayId == getUserData().barangayId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Notifications ──────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      // Users only see their own notifications
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['read', 'readAt']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── Announcements ──────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && resource.data.isActive == true;
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isBarangayOfficer()
                        && resource.data.authorId == currentUid()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['authorId', 'targetRoles', 'isPinned']));
      allow delete: if isAdmin();
    }

    // ─── Activity Logs ──────────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      // Only admins can read all logs; users see own logs
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.userId == currentUid());
      // All authenticated users can write their own activity
      allow create: if isAuthenticated() && request.resource.data.userId == currentUid();
      // Logs are immutable
      allow update, delete: if false;
    }

    // ─── Analytics ─────────────────────────────────────────────────────────────
    match /analytics/{snapshotId} {
      allow read: if isAdminOrBarangay();
      allow write: if isAdmin();
    }

    // ─── Feedback ──────────────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == currentUid()
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'adminResponse', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ─── System Settings ────────────────────────────────────────────────────────
    match /systemSettings/{doc} {
      // All authenticated users can read settings (for maintenance mode, feature flags)
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Conversations ──────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated()
                         && currentUid() in resource.data.participantIds;
      allow create: if isAuthenticated()
                    && currentUid() in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && currentUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == currentUid()
                      && currentUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update: if isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }

  }
}
