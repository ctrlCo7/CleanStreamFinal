rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    // An account the Super Admin has deactivated or removed loses every power immediately
    // (not just the ability to sign in again).
    function inGoodStanding() {
      return getUserData().get('isActive', true) != false && !('deletedAt' in getUserData());
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role && inGoodStanding();
    }

    // Admin and Barangay Official sign-ups must have their ID and face checked by the
    // Super Admin. Until then the profile is marked idVerification == 'pending' (or
    // 'rejected') and carries NO staff powers. Accounts without the field (everyone who
    // existed before this check, and accounts the Super Admin created) are unaffected.
    function idCleared() {
      return getUserData().get('idVerification', 'approved') == 'approved' && emailConfirmed();
    }

    // Citizens, officials and Captains who sign themselves up must confirm their email address
    // before they can report or use staff powers. Their profile carries
    // emailVerificationRequired: true (set at sign-up, can't be removed by them). Accounts
    // created before this check, and accounts the Super Admin creates, don't carry it.
    function emailConfirmed() {
      return getUserData().get('emailVerificationRequired', false) != true
          || request.auth.token.email_verified == true;
    }

    // The Barangay Captain: the head of one barangay, over its officials (stored role 'admin').
    // Everything a Captain may do is limited to their own barangay.
    function isAdmin() {
      return hasRole('admin') && idCleared();
    }

    function isCaptainOf(barangayId) {
      return isAdmin() && inMyBarangay(barangayId);
    }

    // The Super Admin (web portal only) is the sole manager of accounts: creating,
    // editing, deactivating and removing them. Admins keep read access to users
    // (for messaging/analytics) but can no longer change anyone's account.
    // A deactivated or removed Super Admin immediately loses these powers.
    function isSuperAdmin() {
      return hasRole('superadmin')
          && getUserData().get('isActive', true) != false
          && !('deletedAt' in getUserData());
    }

    function isBarangayOfficer() {
      return hasRole('barangay') && idCleared();
    }

    function isCleanupTeam() {
      return hasRole('cleanup_team');
    }

    function isCitizen() {
      return hasRole('citizen');
    }

    function isAdminOrBarangay() {
      return isAuthenticated() && getUserData().role in ['admin', 'barangay'] && idCleared() && inGoodStanding();
    }

    function isStaff() {
      return isAuthenticated() && getUserData().role in ['admin', 'barangay', 'cleanup_team'] && idCleared() && inGoodStanding();
    }

    function isOwner(userId) {
      return isAuthenticated() && currentUid() == userId;
    }

    function sameBarangay(barangayId) {
      return isAuthenticated() && getUserData().barangayId == barangayId;
    }

    // Strict version for reports: an account with no barangay matches nothing.
    function inMyBarangay(barangayId) {
      return isAuthenticated() && getUserData().get('barangayId', null) != null
          && getUserData().barangayId == barangayId;
    }

    function isNotDeleted() {
      return !('deleted' in resource.data) || resource.data.deleted == false;
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    // citizens read own profile; admin reads all; barangay reads members;
    // only the Super Admin can create arbitrary accounts or change/remove anyone's.
    match /users/{userId} {
      // Staff only see the people of their OWN barangay (crews, officials, the Captain, residents);
      // personal details of other barangays' people stay private. The Super Admin sees everyone.
      allow read: if isOwner(userId) || isSuperAdmin()
                  || ((isAdmin() || isBarangayOfficer()) && inMyBarangay(resource.data.get('barangayId', null)));
      // Self sign-up can never grant itself approval or powers: it must start unverified and
      // active, and a Barangay Official or Admin must start with idVerification == 'pending'.
      allow create: if (isAuthenticated() && currentUid() == userId
                        && request.resource.data.keys().hasAll(['uid', 'email', 'firstName', 'lastName', 'role'])
                        && request.resource.data.get('isVerified', false) == false
                        && request.resource.data.get('isActive', true) == true
                        && !('deletedAt' in request.resource.data)
                        // Signing yourself up always comes with email confirmation.
                        && request.resource.data.get('emailVerificationRequired', false) == true
                        // Cleanup-team accounts are created only by the Super Admin (web portal).
                        && (request.resource.data.role == 'citizen'
                            || (request.resource.data.role in ['barangay', 'admin']
                                && request.resource.data.get('idVerification', '') == 'pending')))
                    || isSuperAdmin();
      // Owners can't touch privileged fields, except resubmitting after a rejection
      // (idVerification 'rejected' -> 'pending').
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'isVerified', 'isActive', 'deletedAt', 'deletedBy', 'createdBy', 'idRejectionReason',
                                     'emailVerificationRequired',
                                     // An official's barangay decides which reports and crews they control,
                                     // so only the Super Admin changes it.
                                     'barangayId', 'barangay', 'email'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['idVerification'])
                            || (resource.data.get('idVerification', '') == 'rejected'
                                && request.resource.data.idVerification == 'pending')))
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Identity verification (ID photo + selfies) ───────────────────────────
    // Very sensitive: readable only by the applicant and the Super Admin. The Super Admin
    // portal deletes the images as soon as a decision is made.
    match /verifications/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending'
                    && getUserData().get('idVerification', '') == 'pending'
                    && request.resource.data.keys().hasOnly(['uid', 'role', 'idType', 'idImage', 'selfieNeutral',
                         'selfieSmile', 'selfieTurn', 'clientChecks', 'status', 'submittedAt']);
      // Only a rejected applicant can send a new submission; everything else is the reviewer's.
      allow update: if isSuperAdmin()
                    || (isOwner(uid)
                        && resource.data.status == 'rejected'
                        && request.resource.data.uid == uid
                        && request.resource.data.status == 'pending'
                        && getUserData().get('idVerification', '') == 'pending'
                        && request.resource.data.keys().hasOnly(['uid', 'role', 'idType', 'idImage', 'selfieNeutral',
                             'selfieSmile', 'selfieTurn', 'clientChecks', 'status', 'submittedAt']));
      allow delete: if isSuperAdmin();
    }

    // ─── Audit log (Super Admin portal) ─────────────────────────────────────────
    // Append-only record of every account change made from the web portal.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.actorUid == currentUid();
      allow update, delete: if false;
    }

    // ─── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // The Super Admin oversees every barangay in Cebu City and reads all reports. Everyone
      // else (citizens, officials, crews, the Admin) only sees their own barangay's reports,
      // plus any report they filed themselves: queries must filter on barangayId or userId.
      // An account without a barangay sees only its own reports.
      allow read: if isSuperAdmin()
                  || (isAuthenticated()
                      && (isOwner(resource.data.userId) || inMyBarangay(resource.data.barangayId)));

      // Fields only staff set during verification, scheduling and closing. A new report can't
      // arrive with them already filled in (e.g. pre-"verified", or with training labels).
      function staffReportFields() {
        return ['verifiedBy', 'verifiedByName', 'verifiedAt', 'assignedTeamId', 'assignedTeamName', 'assignedBarangayId',
                'cleanupTaskId', 'assignedAt', 'resolvedAt', 'rejectionReason', 'groundTruthSeverity', 'groundTruthWasteType'];
      }
      // What the reporter's own phone writes after filing, while the report is still pending:
      // the uploaded photo, the AI result, their answer about the waste, the duplicate check.
      function ownerReportFields() {
        return ['notes', 'photoURL', 'photoPending', 'thumbnailURL', 'aiAnalysis', 'severity', 'wasteTypes', 'citizenWasteType',
                'nearbyReportCount', 'duplicateOf', 'duplicateOfNumber', 'duplicateDistanceM', 'updatedAt'];
      }

      // Citizens and barangay officers can create reports, always as themselves and always
      // starting as 'pending' (waiting for verification).
      allow create: if isAuthenticated()
                    && (isCitizen() || isBarangayOfficer())
                    && emailConfirmed()
                    && request.resource.data.userId == currentUid()
                    && request.resource.data.keys().hasAll(['userId', 'location', 'status', 'severity'])
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.keys().hasAny(staffReportFields());

      // Status transitions — strict role-based write access.
      // For everyone, the Admin included: a report never moves to another barangay, and it can
      // only be assigned to its own barangay.
      allow update: if isAuthenticated()
                    && request.resource.data.get('barangayId', null) == resource.data.get('barangayId', null)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedBarangayId'])
                        || request.resource.data.assignedBarangayId == resource.data.get('barangayId', null))
                    && (
                      // Owner: only their phone's own follow-up writes (photo, AI result, waste answer,
                      // duplicate check), and only while the report is still pending. Once an official
                      // has verified it, the reporter can no longer change its severity or analysis.
                      (isOwner(resource.data.userId)
                        && resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerReportFields())) ||

                      // Owner: finish a photo upload that failed earlier (photoPending), at any status.
                      // Only while it is pending, so a report's photo can never be swapped afterwards.
                      (isOwner(resource.data.userId)
                        && resource.data.get('photoPending', false) == true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'photoPending', 'updatedAt'])) ||

                      // Barangay official: VERIFICATION ONLY -- verify or reject a pending (or verified)
                      // report in their own barangay, touching only the verification fields. Scheduling
                      // (assigned) and closing (completed) are the Captain's.
                      (isBarangayOfficer()
                        && inMyBarangay(resource.data.barangayId)
                        && resource.data.status in ['pending', 'verified']
                        && request.resource.data.status in ['verified', 'rejected']
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'updatedAt', 'statusHistory', 'verifiedBy', 'verifiedByName', 'verifiedAt',
                                      'rejectionReason', 'groundTruthSeverity', 'groundTruthWasteType'])) ||

                      // The crew assigned to it marks it "in progress" when they start the cleanup.
                      (isCleanupTeam()
                        && resource.data.get('assignedTeamId', '') == currentUid()
                        && resource.data.status == 'assigned'
                        && request.resource.data.status == 'in_progress'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'statusHistory'])) ||

                      // Captain: any other change, only for their own barangay's reports
                      (isAdmin() && inMyBarangay(resource.data.barangayId))
                    );

      allow delete: if isAdmin() && inMyBarangay(resource.data.barangayId);
    }

    // ─── Barangays ─────────────────────────────────────────────────────────────
    match /barangays/{barangayId} {
      allow read: if isAuthenticated();
      // The Super Admin adds barangays that aren't on the built-in list when creating accounts.
      allow create: if isSuperAdmin() && request.resource.data.id == barangayId;
      allow update: if isCaptainOf(barangayId) || isSuperAdmin()
                    || (isBarangayOfficer() && sameBarangay(barangayId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['isActive', 'captainName']));
      allow delete: if isSuperAdmin();
    }

    // ─── Field Checkpoints (barangay officer patrol/inspection reports) ─────────
    match /fieldCheckpoints/{checkpointId} {
      // Owner reads their own submissions; the Captain reviews/verifies their barangay's;
      // the Super Admin reads them all for inspection-compliance figures.
      allow read: if isAuthenticated()
                  && (isOwner(resource.data.userId) || isCaptainOf(resource.data.barangayId) || isSuperAdmin());
      allow create: if isBarangayOfficer() && request.resource.data.userId == currentUid();
      // Only the Captain or Super Admin can verify, and only the verification fields may change
      allow update: if (isCaptainOf(resource.data.barangayId) || isSuperAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'verifiedBy', 'verifiedByName', 'verifiedAt']);
      allow delete: if isCaptainOf(resource.data.barangayId);
    }

    // ─── Checkpoints (named waterway monitoring points) ───────────────────────
    // Set up by the Super Admin (or a Captain for their barangay): location, assigned officials and inspection days.
    // An official can only stamp "last inspected" on a checkpoint in their own barangay.
    match /checkpoints/{checkpointId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || isCaptainOf(request.resource.data.barangayId);
      allow delete: if isSuperAdmin() || isCaptainOf(resource.data.barangayId);
      allow update: if isSuperAdmin()
                    || (isCaptainOf(resource.data.barangayId)
                        && request.resource.data.barangayId == resource.data.barangayId)
                    || (isBarangayOfficer()
                        && sameBarangay(resource.data.barangayId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['lastInspectedAt', 'lastInspectedBy', 'lastInspectedByName', 'lastCondition', 'lastIssue',
                                      'inspectionStartedAt', 'inspectionStartedBy', 'inspectionStartedByName']));
    }

    // ─── Checkpoint Alarms (each Captain sets their barangay's daily check time; ─
    // ─── officials can read it but not change it) ─────────────────────────────
    match /checkpointAlarms/{barangayId} {
      allow read: if isAuthenticated();
      allow write: if isCaptainOf(barangayId);
    }

    // ─── Cleanup Tasks ──────────────────────────────────────────────────────────
    match /cleanupTasks/{taskId} {
      // The Super Admin every barangay's; the Admin and officials only their own barangay's;
      // a crew leader only their own tasks.
      allow read: if isAuthenticated() && (
                    isSuperAdmin() ||
                    (isAdmin() && inMyBarangay(resource.data.barangayId)) ||
                    (isBarangayOfficer() && sameBarangay(resource.data.barangayId)) ||
                    (isCleanupTeam() && resource.data.assignedTeamId == currentUid())
                  );

      // A cleanup stays inside the report's barangay: the task's barangay must be the report's,
      // and the crew must be a cleanup crew of that same barangay. Nobody, not even the Admin,
      // can hand it to another barangay's crew.
      function crewOfBarangay(crewId, barangayId) {
        let crew = get(/databases/$(database)/documents/users/$(crewId)).data;
        return crew.role == 'cleanup_team' && crew.get('barangayId', '') == barangayId;
      }
      function reportBarangay(reportId) {
        return get(/databases/$(database)/documents/reports/$(reportId)).data.get('barangayId', '');
      }

      // Fields only the Barangay Captain may set: approving a schedule and closing a cleanup.
      function captainOnlyFields() {
        return ['approvedByUserId', 'approvedByName', 'approvedAt', 'rejectedByUserId', 'rejectedByName',
                'rejectionRemarks', 'confirmedByUserId', 'confirmedAt', 'recordedByUserId', 'recordedByName'];
      }

      // Proposed by an official (status 'proposed', or 'declined' when the automatic conflict
      // check refused it), or scheduled by the Captain (who may also approve it at once:
      // 'assigned'). Always for their own barangay, as themselves, with that barangay's crew.
      allow create: if isAuthenticated()
                    && request.resource.data.assignedByUserId == currentUid()
                    && inMyBarangay(request.resource.data.barangayId)
                    && request.resource.data.barangayId == reportBarangay(request.resource.data.reportId)
                    && crewOfBarangay(request.resource.data.assignedTeamId, request.resource.data.barangayId)
                    && (
                      (isAdmin() && request.resource.data.status in ['proposed', 'declined', 'assigned'])
                      || (isBarangayOfficer()
                          && request.resource.data.status in ['proposed', 'declined']
                          && !request.resource.data.keys().hasAny(captainOnlyFields()))
                    );

      allow update: if isAuthenticated() && (
                      // Captain: approves / rejects / declines schedules and closes cleanups. The task
                      // can't move to another barangay or report; a new crew must be the same barangay's.
                      (isAdmin() && inMyBarangay(resource.data.barangayId)
                        && request.resource.data.barangayId == resource.data.barangayId
                        && request.resource.data.reportId == resource.data.reportId
                        && (request.resource.data.assignedTeamId == resource.data.assignedTeamId
                            || crewOfBarangay(request.resource.data.assignedTeamId, resource.data.barangayId))) ||
                      // Official: may edit details, but never the status or any approval/closing field --
                      // only the Captain can approve, reject or finalize a cleanup schedule.
                      (isBarangayOfficer() && inMyBarangay(resource.data.barangayId)
                        && request.resource.data.barangayId == resource.data.barangayId
                        && request.resource.data.reportId == resource.data.reportId
                        && request.resource.data.assignedTeamId == resource.data.assignedTeamId
                        && request.resource.data.status == resource.data.status
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(captainOnlyFields())) ||
                      // A crew leader can accept/decline, start, document and finish only their own,
                      // APPROVED task, and cannot hand it to someone else
                      (isCleanupTeam()
                        && resource.data.status in ['assigned', 'accepted', 'in_progress']
                        && resource.data.assignedTeamId == currentUid()
                        && request.resource.data.assignedTeamId == resource.data.assignedTeamId
                        && request.resource.data.status in ['accepted', 'in_progress', 'completed', 'cancelled']
                        // Finishing needs proof: at least one "after" photo.
                        && (request.resource.data.status != 'completed'
                            || request.resource.data.get('afterPhotoURLs', []).size() > 0)
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'declineReason', 'progressNotes', 'completionNotes',
                                      'actualStartTime', 'actualEndTime', 'completedAt',
                                      'wasteCollectedKg', 'beforePhotoURLs', 'afterPhotoURLs',
                                      'beforeAnalysis', 'afterAnalysis', 'updatedAt']))
                    );

      allow delete: if isAdmin() && inMyBarangay(resource.data.barangayId);
    }

    // ─── Live crew tracking (one document per task, while the crew drives there) ─
    // Written only by the crew leader the task is assigned to, and only with the task's own
    // barangay/report/reporter (so it can't be shown to the wrong people). Readable by that
    // crew, the barangay's officials and Admin, the Super Admin (any barangay) and the resident who reported it.
    match /crewTracking/{taskId} {
      function trackedTask() {
        return get(/databases/$(database)/documents/cleanupTasks/$(taskId)).data;
      }
      allow read: if isAuthenticated() && (
                    resource.data.crewId == currentUid()
                    || isSuperAdmin()
                    || ((isAdmin() || isBarangayOfficer()) && inMyBarangay(resource.data.barangayId))
                    || resource.data.reporterUserId == currentUid()
                  );
      allow create, update: if isCleanupTeam()
                    && trackedTask().assignedTeamId == currentUid()
                    && request.resource.data.crewId == currentUid()
                    && request.resource.data.taskId == taskId
                    && request.resource.data.barangayId == trackedTask().barangayId
                    && request.resource.data.reportId == trackedTask().reportId
                    && request.resource.data.get('reporterUserId', '') == trackedTask().get('reporterUserId', '')
                    && request.resource.data.status in ['en_route', 'arrived', 'ended'];
      allow delete: if isCaptainOf(resource.data.barangayId);
    }

    // ─── Cleanup Events ────────────────────────────────────────────────────────
    match /cleanupEvents/{eventId} {
      allow read: if isAuthenticated();
      // Created by the Captain or an official, for their own barangay, always as themselves.
      allow create: if isAuthenticated()
                    && request.resource.data.organizedBy == currentUid()
                    && (isCaptainOf(request.resource.data.barangayId)
                        || (isBarangayOfficer() && request.resource.data.barangayId == getUserData().barangayId));
      allow update: if isCaptainOf(resource.data.barangayId) || isSuperAdmin()
                    || (isBarangayOfficer() && sameBarangay(resource.data.barangayId))
                    // Anyone signed in can add or remove only THEMSELVES from the volunteer list, and the
                    // count must equal the list, so it can't be inflated.
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['participantIds', 'currentParticipants', 'updatedAt'])
                        && request.resource.data.currentParticipants == request.resource.data.participantIds.size()
                        && (
                          (request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet()).hasOnly([currentUid()])
                            && resource.data.participantIds.toSet().difference(request.resource.data.participantIds.toSet()).size() == 0)
                          ||
                          (resource.data.participantIds.toSet().difference(request.resource.data.participantIds.toSet()).hasOnly([currentUid()])
                            && request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet()).size() == 0)
                        ));
      allow delete: if isCaptainOf(resource.data.barangayId) || isSuperAdmin();

      // Participants subcollection: residents join/leave themselves; only officials mark attendance
      match /participants/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.attendanceStatus == 'registered';
        allow update: if (isOwner(userId)
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['attendanceStatus']))
                      || ((isAdmin() || isBarangayOfficer())
                          && get(/databases/$(database)/documents/cleanupEvents/$(eventId)).data.barangayId == getUserData().barangayId);
        allow delete: if isOwner(userId)
                      || (isAdmin()
                          && get(/databases/$(database)/documents/cleanupEvents/$(eventId)).data.barangayId == getUserData().barangayId);
      }
    }

    // ─── Schedule locks (one per barangay and day) ─────────────────────────────
    // Bumped inside the transaction that decides a cleanup schedule, so two decisions for the
    // same barangay and day can't run at once (racing approvals can't both pass the conflict check).
    match /scheduleLocks/{lockId} {
      allow read: if isAdmin() || isBarangayOfficer();
      allow create, update: if (isAdmin() || isBarangayOfficer())
                            && inMyBarangay(request.resource.data.barangayId)
                            && lockId == request.resource.data.barangayId + '_' + request.resource.data.date
                            && request.resource.data.keys().hasOnly(['barangayId', 'date', 'version', 'by', 'updatedAt'])
                            && request.resource.data.by == currentUid();
      allow delete: if false;
    }

    // ─── Staff directory (who to notify in a barangay) ──────────────────────────
    // Only account ids, no personal details. Officials and the Captain add only THEMSELVES,
    // only in their own barangay, and can't remove anyone; the Super Admin maintains it.
    // ─── Cleanup team account requests ──────────────────────────────────────────
    // An official or the Captain asks the Super Admin for a crew account for THEIR barangay.
    // Only the Super Admin answers (creates the account, or declines with a reason); the
    // requester may withdraw their own request while it is still waiting. Never deleted.
    match /crewRequests/{requestId} {
      allow read: if isSuperAdmin() || (isAdminOrBarangay() && inMyBarangay(resource.data.barangayId));
      allow create: if isAdminOrBarangay()
                    && request.resource.data.requestedBy == currentUid()
                    && inMyBarangay(request.resource.data.barangayId)
                    && request.resource.data.requestedByRole == getUserData().role
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['barangayId', 'barangay', 'requestedBy', 'requestedByName', 'requestedByRole',
                         'teamName', 'crewSize', 'leaderName', 'leaderEmail', 'leaderPhone', 'reason', 'status', 'createdAt'])
                    && request.resource.data.teamName is string
                    && request.resource.data.teamName.size() >= 3 && request.resource.data.teamName.size() <= 60
                    && request.resource.data.crewSize is int
                    && request.resource.data.crewSize >= 1 && request.resource.data.crewSize <= 100
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow update: if (resource.data.status == 'pending'
                        && isAdminOrBarangay() && resource.data.requestedBy == currentUid()
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
                    || (isSuperAdmin() && resource.data.status == 'pending'
                        && request.resource.data.status in ['approved', 'declined']
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'decidedAt', 'decidedBy', 'decidedByName', 'declineReason', 'accountUid', 'accountEmail']));
      allow delete: if false;
    }

    match /barangayStaff/{barangayId} {
      function listBefore(field) {
        return resource == null ? [] : resource.data.get(field, []);
      }
      function addsOnlyMe(field) {
        return request.resource.data.get(field, []).toSet().difference(listBefore(field).toSet()).hasOnly([currentUid()])
            && listBefore(field).toSet().difference(request.resource.data.get(field, []).toSet()).size() == 0;
      }
      function unchanged(field) {
        return request.resource.data.get(field, []) == listBefore(field);
      }
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin()
                            || (inMyBarangay(barangayId)
                                && request.resource.data.keys().hasOnly(['officials', 'captains', 'updatedAt'])
                                && ((isBarangayOfficer() && addsOnlyMe('officials') && unchanged('captains'))
                                    || (isAdmin() && addsOnlyMe('captains') && unchanged('officials'))));
      allow delete: if isSuperAdmin();
    }

    // ─── Push tokens (so notifications reach phones even when the app is closed) ───
    // Each person writes only their own, and can't claim to be staff. Staff tokens are
    // readable by anyone signed in (residents notify their officials); residents' tokens only
    // by staff (who send them report updates).
    match /pushTokens/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin() || isAdmin() || isBarangayOfficer() || isCleanupTeam()
                  || (isAuthenticated() && resource.data.get('staff', false) == true);
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['token', 'platform', 'staff', 'muted', 'updatedAt'])
                            && request.resource.data.token is string
                            && request.resource.data.staff == (getUserData().role in ['barangay', 'admin', 'cleanup_team', 'superadmin']);
      allow delete: if isOwner(uid) || isSuperAdmin();
    }

    // ─── Notifications ──────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      // Users only see their own notifications
      allow read: if isOwner(resource.data.userId);
      // Always signed with the sender (no anonymous or forged notices), and never pre-read.
      allow create: if isAuthenticated()
                    && request.resource.data.get('senderId', '') == currentUid()
                    && request.resource.data.get('read', false) == false;
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['read', 'readAt']);
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── Announcements ──────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && resource.data.isActive == true;
      // A Captain posts only to their own barangay's officials.
      allow create: if isAdmin()
                    && request.resource.data.authorId == currentUid()
                    && request.resource.data.targetBarangayIds == [getUserData().barangayId];
      allow update: if isSuperAdmin()
                    || (isAdmin() && resource.data.authorId == currentUid()
                        && request.resource.data.targetBarangayIds == resource.data.targetBarangayIds)
                    || (isBarangayOfficer()
                        && resource.data.authorId == currentUid()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['authorId', 'targetRoles', 'isPinned']));
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.authorId == currentUid());
    }

    // ─── Activity Logs ──────────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      // Users see their own logs; the Captain their barangay's (activity log); the Super Admin all
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.userId == currentUid())
                  || isCaptainOf(resource.data.get('barangayId', null));
      // All authenticated users write their own activity, and only for their own barangay
      allow create: if isAuthenticated() && request.resource.data.userId == currentUid()
                    && (!('barangayId' in request.resource.data) || sameBarangay(request.resource.data.barangayId));
      // Logs are immutable
      allow update, delete: if false;
    }

    // ─── Analytics ─────────────────────────────────────────────────────────────
    match /analytics/{snapshotId} {
      allow read: if isAdminOrBarangay() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ─── Feedback ──────────────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read: if isOwner(resource.data.userId) || isSuperAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == currentUid()
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if isSuperAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'adminResponse', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    // ─── System Settings ────────────────────────────────────────────────────────
    match /systemSettings/{doc} {
      // All authenticated users can read settings (for maintenance mode, feature flags)
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── Conversations ──────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      // A citizen's chat with a barangay's shared inbox carries barangayId: every official
      // of that barangay can read and answer it.
      function inboxOfficial(conv) {
        return conv.get('barangayId', null) != null && isBarangayOfficer() && inMyBarangay(conv.barangayId);
      }
      function conversation() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      allow read, write: if isAuthenticated()
                         && currentUid() in resource.data.participantIds;
      allow read: if inboxOfficial(resource.data);
      // Officials only touch the preview and the unread counts.
      allow update: if inboxOfficial(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessage', 'lastMessageTime', 'unreadCounts']);
      // Anyone may open an inbox chat with any barangay, but only as themselves.
      allow create: if isAuthenticated()
                    && currentUid() in request.resource.data.participantIds
                    && (request.resource.data.get('barangayId', null) == null
                        || (request.resource.data.get('citizenId', '') == currentUid()
                            && request.resource.data.participantIds == [currentUid()]));

      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && (currentUid() in conversation().participantIds || inboxOfficial(conversation()));
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == currentUid()
                      && (currentUid() in conversation().participantIds || inboxOfficial(conversation()));
        // Only people in the conversation mark messages read.
        allow update: if isAuthenticated()
                      && (currentUid() in conversation().participantIds || inboxOfficial(conversation()))
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }

  }
}
